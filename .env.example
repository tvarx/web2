# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SPORTS_API_BASE: Base URL of the sports content API (fetch happens server-side
# at build time, so no CORS is involved). Used by scripts/fetch-sports-data.mjs.
SPORTS_API_BASE="https://api.tvarx.com"

# VALIDATE_VIDEOS: When true (default), the fetch script HEAD-checks every
# exercise video URL and drops links whose CDN files are missing (404), so the
# shipped site never embeds a player that cannot start. Posters are kept.
# Set to "0" to skip validation and trust the API's media payload as-is.
VALIDATE_VIDEOS="1"

# SITE_BASE_URL: The site's own canonical domain (no trailing slash), used for
# canonical URLs, hreflang links, sitemap.xml and robots.txt generated during
# prerendering. Read by scripts (process.env) and the client
# (VITE_SITE_BASE_URL via import.meta.env). Both should match in production.
SITE_BASE_URL="https://tvarx.com"
VITE_SITE_BASE_URL="https://tvarx.com"
